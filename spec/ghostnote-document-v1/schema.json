  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rational": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,95})(/[1-9][0-9]{0,95})?$",
      "maxLength": 194
    },
    "nonnegative": {
      "type": "string",
      "pattern": "^-?0(/[1-9][0-9]{0,95})?$|^[1-9][0-9]{0,95}(/[1-9][0-9]{0,95})?$",
      "maxLength": 194
    },
    "positive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,95}(/[1-9][0-9]{0,95})?$",
      "maxLength": 193
    },
    "range": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/nonnegative"
        },
        "to": {
          "$ref": "#/$defs/positive"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "properties": {
        "velocitySpread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timbre": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transpose": {
          "type": "number",
          "minimum": -128,
          "maximum": 128
        }
